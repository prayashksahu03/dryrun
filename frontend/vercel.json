{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!visualize|sitemap\\.xml|robots\\.txt|og\\.png|assets).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/visualize/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
